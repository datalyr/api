{
  "name": "@datalyr/api",
  "version": "1.3.4",
  "description": "DATALYR Node SDK for server-side event, identity and revenue tracking",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --clean",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "node tests/test.ts && node tests/retry.ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "datalyr",
    "analytics",
    "tracking",
    "attribution",
    "server-side",
    "node"
  ],
  "author": "Datalyr",
  "license": "MIT",
  "homepage": "https://docs.datalyr.com/sdk-reference/node",
  "repository": {
    "type": "git",
    "url": "https://github.com/datalyr/api.git"
  },
  "bugs": {
    "url": "https://github.com/datalyr/api/issues"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
